@page
@model frontpageMA.Pages.Ventanas.VehiculosModel
@{
    ViewData["Title"] = "Vehiculos";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Gestión de Vehículos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

           
            <input id="flModelo"
                   placeholder="Filtrar por Modelo"
                   asp-for="@Model.Filtro!.Modelo" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Vehículo</h3>

                <label>Placa</label>
                <input id="nmPlaca"
                       asp-for="@Model.Actual!.Placa" />
                <br />

                <label>Modelo</label>
                <input id="nmModelo"
                       asp-for="@Model.Actual!.Modelo" />
                <br />

                <label>Precio</label>
                <input id="nmPrecio" type="number" step="0.01"
                       asp-for="@Model.Actual!.Precio" />
                <br />

                <label>Fecha de Venta</label>
                <input id="nmFechaVenta" type="datetime-local"
                       asp-for="@Model.Actual!.FechaVenta" />
                <br />

                <label>Notas</label>
                <input id="nmNotas"
                       asp-for="@Model.Actual!.Notas" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el vehículo con placa
                        @Model.Actual!.Placa,
                        modelo @Model.Actual!.Modelo?
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Placa</th>
                        <th>Modelo</th>
                        <th>Precio</th>
                        <th>Fecha Venta</th>
                        <th>Notas</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Placa</td>
                                <td>@elemento.Modelo</td>
                                <td>@elemento.Precio.ToString("C")</td>
                                <td>@elemento.FechaVenta</td>
                                <td>@elemento.Notas</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>